            "CategoryName": "General",
            "Rules": [
                {
                    "RuleParagraph": "1.1.",
                    "RuleText": "PVP is allowed only in the PVP Zones (Check the iZurvive Map for details. PVP outside of these zones (including damaging player bases of property) will result in a ban."
                },
                {
                    "RuleParagraph": "1.2.",
                    "RuleText": "Provocations and toxic behavior will not be tolerated. This includes sharing racist or extremist ideas or otherwise distrubing the harmony of the server."
                },
                {
                    "RuleParagraph": "1.3.",
                    "RuleText": "The use of cheats, scripts, or external programs will result in a ban."
                },
                {
                    "RuleParagraph": "1.5.",
                    "RuleText": "The rules are not debatable. Admin descisions are final."
                }
            ]
        }
    ],
