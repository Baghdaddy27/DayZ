    "RuleCategories": [
        {
            "CategoryName": "General",
            "Rules": [
                {
                    "RuleParagraph": "1.",
                    "RuleText": "PVP is allowed only in the designated PVP zones. Anyone who attempts to PVP in the PVE areas will be banned. This includes raiding bases, laying mines or traps, etc."
                },
                {
                    "RuleParagraph": "2.",
                    "RuleText": "Cheating, Exploiting, Scripting, ESP/Aimbotting, Duping, Glitching, using third party software (NVIDIA Filters, ReShade, SweetFX, or any similar software), or trying to bypass server systems will result in an immediate and permanent ban."
                },
                {
                    "RuleParagraph": "3.",
                    "RuleText": "Logging out to avoid death or loss during combat is not allowed."
                },
                {
                    "RuleParagraph": "4.",
                    "RuleText": "Treat everyone with respect. Harassment, Toxic behavior, Racism, Bigotry, or Personal attacks will result in a ban."
                },
                {
                    "RuleParagraph": "5.",
                    "RuleText": "Theft of player owned vehicles outside of PVP zones is prohibited. Hoarding vehicles is prohibited. 1 Vehicle of each type per person (boat, car, helicopter, etc). Vehicles in PVP zones are fair game."
                },
                {
                    "RuleParagraph": "6.",
                    "RuleText": "Advertising other servers, communities, or services is not allowed."
                },
                {
                    "RuleParagraph": "7.",
                    "RuleText": "All reports of cheating or bad conduct must include video or screenshots. Reports without proof wont be acted on."
                },
                {
                    "RuleParagraph": "8.",
                    "RuleText": "Bans are permanent, and admins have the final say in all situations."
                }
            ]
        }
    ],
