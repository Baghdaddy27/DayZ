<messages>
    <message>
        <delay>2</delay>
        <onconnect>1</onconnect>
        <text>Welcome to Caffeinated AF [CAF]! A Non-Toxic PVE server with static and dynamic PVP zones.</text>
    </message>
    <message>
        <delay>5</delay>
        <onconnect>1</onconnect>
        <text>Read server information, form parties, and more from your LogBook. Press B to open.</text>
    </message>
        <message>
        <repeat>30</repeat>
        <text>Question, comment, or concern? Let us know on the Discord. The link is on the game menu and in the log book.</text>
    </message>

